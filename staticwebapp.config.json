{
  "platform": {
    "apiRuntime": "node:20"
  },
  "auth": {
    "rolesSource": "/api/auth/get-roles",
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://login.microsoftonline.com/4122848f-c317-4267-9c07-7c504150d1bd/v2.0",
          "clientIdSettingName": "AAD_CLIENT_ID",
          "clientSecretSettingName": "AAD_CLIENT_SECRET"
        }
      }
    }
  },
  "routes": [
    {
      "route": "/api/auth/get-roles",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/members/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/admin/*",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["admin"]
    },
    {
      "route": "/about/emergency-personnel",
      "redirect": "/about/our-team/",
      "statusCode": 301
    },
    {
      "route": "/governance",
      "redirect": "/about/governance/",
      "statusCode": 301
    },
    {
      "route": "/about",
      "redirect": "/about/who-we-are/",
      "statusCode": 301
    },
    {
      "route": "/services",
      "redirect": "/services/emergency-services/",
      "statusCode": 301
    },
    {
      "route": "/about/board-of-commissioners",
      "redirect": "/about/governance/",
      "statusCode": 301
    },
    {
      "route": "/governance/documents",
      "redirect": "/about/governance/",
      "statusCode": 301
    },
    {
      "route": "/governance/board-of-commissioners",
      "redirect": "/about/governance/",
      "statusCode": 301
    },
    {
      "route": "/board-of-commissioners",
      "redirect": "/about/governance/",
      "statusCode": 301
    },
    {
      "route": "/contact-us",
      "redirect": "/contact/",
      "statusCode": 301
    },
    {
      "route": "/about/staff",
      "redirect": "/about/our-team/",
      "statusCode": 301
    },
    {
      "route": "/about-us",
      "redirect": "/about/who-we-are/",
      "statusCode": 301
    },
    {
      "route": "/about/about-san-juan-fire-and-rescue",
      "redirect": "/about/key-information/",
      "statusCode": 301
    },
    {
      "route": "/privacy-policy",
      "redirect": "/disclaimer/",
      "statusCode": 301
    },
    {
      "route": "/firewise",
      "redirect": "/services/firewise/",
      "statusCode": 301
    },
    {
      "route": "/ems",
      "redirect": "/news/2022-01-18-we-are-an-ems-agency/",
      "statusCode": 301
    },
    {
      "route": "/news/2022-01-18-sjifandr-is-an-ems-agency",
      "redirect": "/news/2022-01-18-we-are-an-ems-agency/",
      "statusCode": 301
    },
    {
      "route": "/news/media-releases/*",
      "redirect": "https://sjifires.sharepoint.com/sites/SJIFirePublicRecords/Reading%20Room/Forms/AllItems.aspx?id=%2Fsites%2FSJIFirePublicRecords%2FReading%20Room%2FGovernance%20Documents%2FPRESS%20RELEASES%20%26%20NOTICES&viewid=f8bff041%2Db27e%2D4096%2Db436%2D8e5e92daf685&p=true",
      "statusCode": 301
    },
    {
      "route": "/assets/docs/*",
      "redirect": "https://sjifires.sharepoint.com/:f:/s/SJIFirePublicRecords/IgBbJPhsXp0iTLx2WataGf3dARGo93hz2540LD3Gmcu4LRk?e=qgTsB4",
      "statusCode": 301
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/assets/*", "/css/*", "/js/*", "/admin/*", "/api/*", "/.auth/*"]
  },
  "responseOverrides": {
    "401": {
      "statusCode": 302,
      "redirect": "/.auth/login/aad?post_login_redirect_uri=/admin/&prompt=select_account"
    }
  },
  "globalHeaders": {
    "Content-Security-Policy": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: blob: https://res.cloudinary.com https://*.cloudinary.com; font-src 'self' data: https://fonts.gstatic.com; connect-src 'self' https://res.cloudinary.com https://api.cloudinary.com https://content.cloudinary.com; frame-src 'self' https://*.facebook.com https://*.facebook.net https://*.arcgis.com https://www.google.com https://maps.google.com https://calendar.google.com https://www.youtube.com https://youtube.com https://www.youtube-nocookie.com https://player.vimeo.com https://vimeo.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'",
    "Strict-Transport-Security": "max-age=31536000; includeSubDomains",
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "X-XSS-Protection": "1; mode=block",
    "Referrer-Policy": "strict-origin-when-cross-origin",
    "Permissions-Policy": "geolocation=(), microphone=(), camera=()"
  }
}
