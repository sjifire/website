---js
{
  layout: "base",
  pagination: {
    data: "posts",
    size: 1,
    alias: "post",
    reverse: true
  },
  permalink: "{{ post.url }}/index.html",
  eleventyComputed: {
    title: "{{ post.title }}",
    description: "{{ post.lede | markdownify }}"
  }
}
---

{% if post.archived %}
<div class="archive-banner" style="background-color: #f0f0f0; border-left: 4px solid #666; padding: 0.75rem 1rem; margin-bottom: 1.5rem; max-width: 48rem; margin-left: auto; margin-right: auto;">
  <strong>Archived</strong> — This post is no longer shown in the news feed. <a href="/news/archive/">Browse the archive</a>.
</div>
{% endif %}

<article class="l-squeezed">
  <div class="block-content">
    {{ post.body | markdownify | processStyledImages }}
  </div>
</article>

<nav class="l-squeezed pagination">
  {% if pagination.href.previous %}
    <a href="{{ pagination.href.previous | url }}">« Next</a>
  {% else %}
    <span>« Next</span>
  {% endif %}
    <a href="/news/">All</a>
  {% if pagination.href.next %}
    <a href="{{ pagination.href.next | url }}">Prev »</a>
  {% else %}
    <span>Prev »</span>
  {% endif %}
</nav>
