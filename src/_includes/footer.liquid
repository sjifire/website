<nav class="footer-nav">
  {% for item in nav.items %}
    {% if item.children and item.children.size > 0 %}
      <dl class="footer-navgroup">
        <dt class="footer-heading">{{ item.label }}</dt>
        {% for child in item.children %}
          <dd class="footer-navlink"><a href="{{ child.url }}">{% if child.nav_title %}{{ child.nav_title }}{% else %}{{ child.label }}{% endif %}</a></dd>
        {% endfor %}
      </dl>
    {% elsif item.url and item.label != "Gallery" and item.label != "Contact" %}
      <dl class="footer-navgroup">
        <dt class="footer-heading">{{ item.label }}</dt>
        <dd class="footer-navlink"><a href="{{ item.url }}">{{ item.label }}</a></dd>
      </dl>
    {% endif %}
  {% endfor %}

  <dl class="footer-navgroup">
    <dt class="footer-heading">Connect</dt>
    <dd class="footer-navlink"><a href="/gallery/">Gallery</a></dd>
    <dd class="footer-navlink"><a href="/contact/">Contact Us</a></dd>
    {% if nav.headerHighlight %}
    <dd class="footer-navlink"><a href="{{ nav.headerHighlight.url | safeUrl }}">{{ nav.headerHighlight.nav_title }}</a></dd>
    {% endif %}
    <dd class="footer-navlink">
      <a href="https://www.facebook.com/SJIFire/"><svg class="footer-icon"><use xlink:href="#facebook"></use></svg> Facebook</a>
    </dd>
    <dd class="footer-navlink">
      <a href="https://www.instagram.com/sjifire/"><svg class="footer-icon"><use xlink:href="#instagram"></use></svg> Instagram</a>
    </dd>
    <dd class="footer-navlink">
      {% render "language-switcher.liquid", site: site, page: page %}
    </dd>
  </dl>

  <dl class="footer-navgroup">
    <dt class="footer-heading">Resources</dt>
    <dd class="footer-navlink"><a href="/.auth/login/aad?post_login_redirect_uri=/members/">Member Portal</a></dd>
    <dd class="footer-navlink"><a href="https://www.islandsready.org/">SJC Department of Emergency Management</a></dd>
    <dd class="footer-navlink"><a href="https://www.sanjuancountywa.gov/2169/Health-Community-Services">SJC Community Health</a></dd>
    <dd class="footer-navlink"><a href="https://www.sanjuancountywa.gov/1088/Fire-Marshal">SJC Fire Marshal</a></dd>
    <dd class="footer-navlink"><a href="https://public.alertsense.com/SignUp/?regionid=1213">SJC Emergency Alerts</a></dd>
  </dl>
</nav>

<aside class="footer-legal">
  <p>&copy; {{ helpers.buildYear }} {{ site.site_name }} | <a href="/disclaimer/">Disclaimer</a></p>
  <address>
    San Juan County Fire District 3, 1011 Mullis Street, Friday Harbor, WA 98250<br>
    Office: <a href="tel:(360) 378-5334">(360) 378-5334</a> | Fax: (360) 378-2591 | Dispatch Non Emergency: <a href="tel:(360) 378-4151">(360) 378-4151</a>
  </address>
</aside>
