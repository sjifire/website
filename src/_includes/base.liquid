{%- comment -%}
  Escaped because pageTitle goes into og:title and twitter:title as well as
  <title>. A post's title is an editor's plain text, so a single escape is
  right here — unlike pageDsc below, which arrives already encoded. Without it
  a post called `The "Big" One` ends the og:title attribute at `The `.

  site_name is a Tina field too, so the same applies wherever it is emitted
  raw — og:site_name and the feed link below. (It holds no ampersand or quote
  today; this is about what an editor can type into it, not a live defect.)
{%- endcomment -%}
{%- if page.url == "/" -%}
  {%- assign pageTitle = site.site_name | escape -%}
{%- else -%}
  {%- assign pageTitle = title | append: " | " | append: site.site_name | escape -%}
{%- endif -%}
{%- comment -%}
  A post's description is `post.lede | markdownify`, so it arrives as HTML and
  goes into content="…" unescaped. Any quote in it — a link's href, or the
  style="…" on a highlight an editor added — ends the attribute early and spills
  the rest into <head>. strip_html leaves the text, entities and all; piping
  through `escape` as well would double-escape them (&amp; -> &amp;amp;). It is
  a naive <[^>]*> strip, though, so a ">" inside an attribute value leaves the
  rest of that tag behind — hence also replacing any bare quote it left.

  It takes two passes. The first picks the source: markdownify turns an
  image-only lede into `<p><img …></p>`, which is truthy, so a `default` applied
  before the strip would keep it and then reduce it to whitespace, shipping an
  empty description. Stripping first means both nil and strips-to-nothing fall
  back. normalize_whitespace collapses the newlines markdownify leaves between
  blocks, which would otherwise break the tag across lines.

  The second pass sanitizes whichever source won. site_desc is a Tina field and
  it is the live value on every page except the news articles — nothing else
  sets a page-level description — so it needs the same treatment, not a free
  pass for being the fallback.
{%- endcomment -%}
{%- assign pageDsc = description | strip_html | normalize_whitespace | strip | default: site.site_desc -%}
{%- assign pageDsc = pageDsc | strip_html | normalize_whitespace | strip | replace: '"', '&quot;' -%}
<!DOCTYPE html>
<html lang="en">
<head>
  {% comment %}preload font?{% endcomment %}
  <meta charset="utf-8">
  <meta name="format-detection" content="telephone=no" />
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no"/>
  <title>{{ pageTitle }}</title>
  {% comment %}meta-desc{% endcomment %}
    <meta name="description" content="{{ pageDsc }}" />
  {% comment %}icon tags{% endcomment %}
    <link rel="icon" type="image/png" href="{% imgPath '/assets/sjifire-logo-clear.png' %}" />
  {% comment %}RSS feed{% endcomment %}
    <link rel="alternate" type="application/atom+xml" title="{{ site.site_name | escape }} News Feed" href="{{ site.prodUrl | escape }}/news/feed.xml" />
  {% comment %}canonical URL{% endcomment %}
    <link rel="canonical" href="{{ site.prodUrl | append: page.url | escape }}" />
  {% comment %}og{% endcomment %}
    <meta property="og:url" content="{{ site.prodUrl | append: page.url | escape }}" key="ogurl" />
    <meta property="og:type" content="website" />
    {%- if page.fileSlug == 'news-article' and post.featured_image and post.featured_image.source != "" -%}
      {%- assign ogImgPath = '/assets/media/' | append: post.featured_image.source -%}
    {%- else -%}
      {%- assign ogImgPath = '/assets/media/' | append: site.opengraph_image -%}
    {%- endif -%}
    {%- comment -%}
      imgPath concatenates the filename into a URL without escaping or
      encoding, and the filename is whatever an editor uploaded — so it needs
      the same treatment as any other attribute value here.
    {%- endcomment -%}
    <meta property="og:image" content="{{ ogImgPath | imgPath: 'f_auto,q_auto:good,c_fill,w_1200,h_630' | escape }}" key="ogimage" />
    <meta property="og:site_name" content="{{ site.site_name | escape }}" key="ogsitename" />
    <meta property="og:title" content="{{ pageTitle }}" key="ogtitle" />
    <meta property="og:description" content="{{ pageDsc }}" key="ogdesc" />
  {% comment %}twitter cards{% endcomment %}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="{{ pageTitle }}" />
    <meta name="twitter:description" content="{{ pageDsc }}" />
    <meta name="twitter:image" content="{{ ogImgPath | imgPath: 'f_auto,q_auto:good,c_fill,w_1200,h_630' | escape }}" />
  {% comment %}additional SEO{% endcomment %}
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="geo.region" content="US-WA" />
    <meta name="geo.placename" content="Friday Harbor" />
    <meta name="geo.position" content="48.5232;-123.0245" />
    <meta name="ICBM" content="48.5232, -123.0245" />
    <link rel="preconnect" href="//google-analytics.com" />
    <link rel="preconnect" href="//googleapis.com" />
    <link rel="preconnect" href="//gstatic.com" />
    <link rel="preconnect" href="//googletagmanager.com" />
    <link rel="preconnect" href="//clarity.ms/ "/>

  {%- comment -%}
    Fire Safety widget: start the status request during head parse rather than
    waiting for /js/burn-status.js to run at DOMContentLoaded. The widget sits in
    the sidebar, so the deferred script fires late; the endpoint is a Lambda
    behind CloudFront and a cold miss costs 2-3s, so the earlier start matters.

    This block MUST stay above <link rel="stylesheet">. A parser-inserted inline
    script cannot execute while an earlier stylesheet is still loading, so below
    it the fetch waits on site.css and the head start is largely lost. Measured
    on a throttled connection: 179ms here, 759ms below the stylesheet.

    burn-status.js consumes this promise, retries itself if it rejected, and
    fetches on its own if it is absent. Gated on include_burn_widget so pages
    without the widget make no request; site.burn_status_api is the single
    source of truth for the URL, shared with burn-status.js.
  {%- endcomment -%}
  {%- if include_burn_widget %}
  <link rel="preconnect" href="{{ site.burn_status_api | split: '/v1/' | first }}" crossorigin>
  <script>
    (function () {
      var controller = new AbortController();
      window.__burnStatusEndpoint = '{{ site.burn_status_api }}';
      window.__burnStatusAbort = function () { controller.abort(); };
      window.__burnStatusFetch = fetch('{{ site.burn_status_api }}', { signal: controller.signal })
        .then(function (r) { if (!r.ok) throw new Error('HTTP ' + r.status); return r.json(); });
      // Pre-empt an unhandled rejection if the widget script never loads.
      window.__burnStatusFetch.catch(function () {});
    })();
  </script>
  {%- endif %}

  <link rel="stylesheet" href="/css/site.css">

  {% comment %}JSON-LD Structured Data{% endcomment %}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "FireStation",
    "@id": {{ site.prodUrl | append: "/#organization" | jsonLd }},
    "name": {{ site.site_name | jsonLd }},
    "alternateName": "SJIF&R",
    "legalName": "San Juan County Fire District #3",
    "url": {{ site.prodUrl | jsonLd }},
    "logo": {{ site.prodUrl | append: "/assets/sjifire-logo-clear.png" | jsonLd }},
    "description": {{ site.site_desc | jsonLd }},
    "telephone": "360-378-5334",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "1011 Mullis Street",
      "addressLocality": "Friday Harbor",
      "addressRegion": "WA",
      "postalCode": "98250",
      "addressCountry": "US"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": 48.5232,
      "longitude": -123.0245
    },
    "areaServed": {
      "@type": "Place",
      "name": "San Juan Island, San Juan County, Washington"
    },
    "sameAs": [
      "https://www.facebook.com/SJIFire/",
      "https://www.instagram.com/sjifire/"
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "url": {{ site.prodUrl | jsonLd }},
    "name": {{ site.site_name | jsonLd }},
    "description": {{ site.site_desc | jsonLd }},
    "publisher": {
      "@id": {{ site.prodUrl | append: "/#organization" | jsonLd }}
    }
  }
  </script>
  {%- if page.fileSlug == 'news-article' and post -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "NewsArticle",
    {%- comment -%}
      `post.excerpt` is not in the Tina post schema and exists in no post file,
      so the old `post.excerpt | default: post.title` made every article's
      description a copy of its headline. `lede` is the field that holds the
      summary; plainText because entities do not decode in a script body.
    {%- endcomment -%}
    "headline": {{ post.title | jsonLd }},
    "description": {{ post.lede | plainText | default: post.title | jsonLd }},
    "datePublished": "{{ post.date | date: '%Y-%m-%dT%H:%M:%S-08:00' }}",
    "dateModified": "{{ post.date | date: '%Y-%m-%dT%H:%M:%S-08:00' }}",
    "author": {
      "@type": "Organization",
      "@id": {{ site.prodUrl | append: "/#organization" | jsonLd }}
    },
    "publisher": {
      "@id": {{ site.prodUrl | append: "/#organization" | jsonLd }}
    },
    "mainEntityOfPage": {
      "@type": "WebPage",
      "@id": {{ site.prodUrl | append: page.url | jsonLd }}
    }
    {%- if post.featured_image and post.featured_image.source != "" -%}
    {%- assign articleImgPath = '/assets/media/' | append: post.featured_image.source -%}
    ,"image": {{ articleImgPath | imgPath: 'f_auto,q_auto:good,w_1200' | jsonLd }}
    {%- endif %}
  }
  </script>
  {%- endif -%}

</head>
<body>

  {% render "svg-sprite.svg" %}

  <header id="home-header" class="site-header{% if page.url == '/' %} site-header--home{% endif %}" role="banner">
    {% render "header.liquid", page: page, title: title, preamble: preamble, post: post, nav: nav, site: site %}
  </header>

  {% if page.fileSlug == 'news-article' and post.featured_image and post.featured_image.source != "" %}
    {%- assign featuredImgPath = '/assets/media/' | append: post.featured_image.source -%}
    <figure class="featured__media">
      <img src="{{ featuredImgPath | imgPath: 'f_auto,c_limit,w_900,h_500' | escape }}" alt="{{ post.featured_image.alt | escape }}" loading="eager">
    </figure>
  {% endif %}

  <main id='site-main' class="site-main{% if page.url == '/' %} site-main--overlap{% endif %}" role="main">
    <div class="rap">
      {{ content }}
    </div>
  </main>

  <footer class="site-footer" role="contentinfo">
    <div class="rap">
      {% render "footer.liquid", nav: nav, helpers: helpers, site: site, page: page %}
    </div>
  </footer>
  {%- capture js -%}
    {% render "nav-js.liquid" %}
    {% if page.url == '/' %}
      const imgs = {{ homepage.header_images | headerImageUrls: header_image_transform }};
      const image = imgs[Math.floor(Math.random() * imgs.length)];
      document.getElementById('home-header').style.setProperty('--home-header-bg-image', 'url('+image+')');
    {% endif %}
    document.querySelectorAll('a[href]').forEach(function(a){var h=a.hostname;if(h&&h!==location.hostname){a.setAttribute('target','_blank');a.setAttribute('rel','noopener');}});
  {%- endcapture -%}
  <script defer>
    {{ js }}
  </script>
  {% comment %}Security: scripts variable is only set via page frontmatter for internal JS files{% endcomment %}
  {% if scripts %}{{ scripts }}{% endif %}
</body>
</html>
