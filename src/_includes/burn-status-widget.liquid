{%- comment -%}
  Fire Safety widget: the StationWorks <burn-status> embed, rendered and kept
  live by permits.sjifire.org. It draws in a shadow root, so site.css cannot
  reach in -- theme it only through the --burn-status-* variables in site.css.
  Config (script, agency id, publishable key) lives in site.json burn_widget.
  The key is a publishable pk_live_ key: it identifies the site, grants nothing.
{%- endcomment -%}
<burn-status
  agency-id="{{ site.burn_widget.agency_id }}"
  key="{{ site.burn_widget.key }}"
  layout="compact"
></burn-status>
<noscript>
  <p class="widget__notice">
    &#9888; Live fire status unavailable. Call
    <a href="tel:+13603785334">(360) 378-5334</a>
    or see
    <a href="{{ site.permits_url }}">Burn Permits &rsaquo;</a>
  </p>
</noscript>
<script async src="{{ site.burn_widget.script }}"></script>
