---
permalink: /news/feed.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="utf-8"?>
<feed xmlns="http://www.w3.org/2005/Atom">
  <title>{{ site.site_name }} - News</title>
  <subtitle>{{ site.site_desc }}</subtitle>
  <link href="{{ site.prodUrl }}/news/feed.xml" rel="self" type="application/atom+xml"/>
  <link href="{{ site.prodUrl }}/news/" rel="alternate" type="text/html"/>
  <updated>{{ "now" | date: "%Y-%m-%dT%H:%M:%SZ" }}</updated>
  <id>{{ site.prodUrl }}/news/</id>
  <author>
    <name>{{ site.site_name }}</name>
    <uri>{{ site.prodUrl }}</uri>
  </author>
  <generator>Eleventy</generator>
  {%- assign sortedPosts = activePosts | sort: "date" | reverse %}
  {%- for post in sortedPosts %}
  <entry>
    <title>{{ post.title | escape }}</title>
    <link href="{{ site.prodUrl }}{{ post.url }}/" rel="alternate" type="text/html"/>
    <id>{{ site.prodUrl }}{{ post.url }}/</id>
    <published>{{ post.date | isoDateTimeUTC }}</published>
    <updated>{{ post.date | isoDateTimeUTC }}</updated>
    {%- if post.excerpt %}
    <summary>{{ post.excerpt | escape }}</summary>
    {%- endif %}
    <content type="html">{{ post.body | markdownify | escape }}</content>
    <author>
      <name>{{ site.site_name }}</name>
    </author>
    {%- for tag in post.tags %}
    <category term="{{ tag }}" />
    {%- endfor %}
  </entry>
  {%- endfor %}
</feed>
