---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- comment %}Homepage{% endcomment %}
  <url>
    <loc>{{ site.prodUrl }}/</loc>
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
  </url>
  {%- comment %}Navigation items from header/footer{% endcomment %}
  {%- for item in nav.items %}
    {%- if item.children and item.children.size > 0 %}
      {%- for child in item.children %}
  <url>
    <loc>{{ site.prodUrl }}{{ child.url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
      {%- endfor %}
    {%- elsif item.url %}
  <url>
    <loc>{{ site.prodUrl }}{{ item.url }}</loc>
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
  </url>
    {%- endif %}
  {%- endfor %}
  {%- comment %}Active news posts{% endcomment %}
  {%- for post in activePosts reversed %}
  <url>
    <loc>{{ site.prodUrl }}{{ post.url }}/</loc>
    <changefreq>monthly</changefreq>
    <priority>0.5</priority>
  </url>
  {%- endfor %}
  {%- comment %}Archived news posts (lower priority, no longer updated){% endcomment %}
  {%- for post in archivedPosts reversed %}
  <url>
    <loc>{{ site.prodUrl }}{{ post.url }}/</loc>
    <lastmod>{{ post.archived_at | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>never</changefreq>
    <priority>0.2</priority>
  </url>
  {%- endfor %}
  {%- comment %}Footer-only pages{% endcomment %}
  {%- for link in nav.footerLinks %}
  <url>
    <loc>{{ site.prodUrl }}{{ link.url }}</loc>
    <changefreq>monthly</changefreq>
    <priority>0.3</priority>
  </url>
  {%- endfor %}
</urlset>
