---
permalink: /sitemap.xml
eleventyExcludeFromCollections: true
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {%- comment %}Static pages from collections{% endcomment %}
  {%- for page in collections.all %}
  {%- unless page.url == false or page.url contains '/admin' or page.url contains '/api' or page.url contains '/404' or page.url == '/thank-you/' or page.url contains '.css' or page.url contains '.xml' or page.url contains '/news/page-' or page.data.nav_hidden or page.data.excludeFromSitemap %}
  {%- comment %}Skip individual news articles from collections - we'll add them from posts data{% endcomment %}
  {%- unless page.url contains '/news/' and page.url != '/news/' and page.url != '/news/media-releases/' %}
  <url>
    <loc>{{ site.prodUrl }}{{ page.url }}</loc>
    {%- if page.date %}
    <lastmod>{{ page.date | date: "%Y-%m-%d" }}</lastmod>
    {%- endif %}
    {%- if page.url == '/' %}
    <changefreq>daily</changefreq>
    <priority>1.0</priority>
    {%- elsif page.url contains '/about/' or page.url contains '/services/' %}
    <changefreq>weekly</changefreq>
    <priority>0.8</priority>
    {%- else %}
    <changefreq>weekly</changefreq>
    <priority>0.7</priority>
    {%- endif %}
  </url>
  {%- endunless %}
  {%- endunless %}
  {%- endfor %}
  {%- comment %}News articles from posts data{% endcomment %}
  {%- assign sortedPosts = posts | sort: "date" | reverse %}
  {%- for post in sortedPosts %}
  <url>
    <loc>{{ site.prodUrl }}{{ post.url }}/</loc>
    <lastmod>{{ post.date | date: "%Y-%m-%d" }}</lastmod>
    <changefreq>monthly</changefreq>
    <priority>0.6</priority>
  </url>
  {%- endfor %}
</urlset>
